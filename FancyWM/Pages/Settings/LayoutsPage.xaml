<UserControl x:Class="FancyWM.Pages.Settings.LayoutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:viewmodels="clr-namespace:FancyWM.ViewModels"
    xmlns:models="clr-namespace:FancyWM.Models"
    d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
    mc:Ignorable="d"
    d:DesignHeight="1100" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="PreviewTileStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Margin" Value="3" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1024" />
        </Grid.ColumnDefinitions>

        <ui:SimpleStackPanel HorizontalAlignment="Stretch" Orientation="Vertical" Margin="12" Spacing="4">
            <TextBlock Text="Layouts" Style="{DynamicResource TitleTextBlockStyle}" Margin="0,0,0,20" />

            <TextBlock Text="Master + Satellites" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,20" />

            <Border Style="{DynamicResource SettingsItemStyle}">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <CheckBox
                            DockPanel.Dock="Right"
                            IsChecked="{Binding MasterSatelliteEnabled, Mode=TwoWay}"
                            AutomationProperties.Name="Enable Master + Satellites"
                            ToolTip="Turn the algorithmic Master + Satellites layout on or off." />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" Text="Enable Master + Satellites" />
                    </DockPanel>
                    <TextBlock
                        Padding="0,16,0,0"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                        Text="Keep one master window beside an ordered group of satellite windows." />
                </StackPanel>
            </Border>

            <ui:SimpleStackPanel
                Orientation="Vertical"
                Spacing="4"
                IsEnabled="{Binding MasterSatelliteEnabled}">

                <TextBlock Text="Preview" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,20" />
                <Border
                    Style="{DynamicResource SettingsItemStyle}"
                    AutomationProperties.Name="Master + Satellites layout preview"
                    AutomationProperties.HelpText="Shows the configured master side, ratio, satellite orientation, and satellite count.">
                    <StackPanel>
                        <Grid x:Name="PreviewGrid" Height="180" MinWidth="300" />
                        <TextBlock
                            x:Name="PreviewLimitText"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Placement" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,20" />

                <Border Style="{DynamicResource SettingsItemStyle}">
                    <StackPanel>
                        <TextBlock Text="Display scope" Margin="0,0,0,8" />
                        <ComboBox
                            Width="300"
                            HorizontalAlignment="Left"
                            SelectedValuePath="Tag"
                            SelectedValue="{Binding AlgorithmicLayoutDisplayScope, Mode=TwoWay}"
                            AutomationProperties.Name="Display scope"
                            ToolTip="Choose which displays use Master + Satellites.">
                            <ComboBoxItem Content="Primary display" Tag="{x:Static models:AlgorithmicLayoutDisplayScope.PrimaryDisplay}" />
                            <ComboBoxItem Content="Ultrawide displays" Tag="{x:Static models:AlgorithmicLayoutDisplayScope.UltrawideDisplays}" />
                            <ComboBoxItem Content="All displays" Tag="{x:Static models:AlgorithmicLayoutDisplayScope.AllDisplays}" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource SettingsItemStyle}">
                    <StackPanel>
                        <TextBlock Text="Master side" Margin="0,0,0,8" />
                        <ComboBox
                            Width="300"
                            HorizontalAlignment="Left"
                            SelectedValuePath="Tag"
                            SelectedValue="{Binding DefaultMasterSide, Mode=TwoWay}"
                            AutomationProperties.Name="Default master side"
                            ToolTip="Choose whether the master starts on the left or right.">
                            <ComboBoxItem Content="Left" Tag="{x:Static models:MasterSide.Left}" />
                            <ComboBoxItem Content="Right" Tag="{x:Static models:MasterSide.Right}" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource SettingsItemStyle}">
                    <StackPanel>
                        <TextBlock Text="Default satellite orientation" Margin="0,0,0,8" />
                        <ComboBox
                            Width="300"
                            HorizontalAlignment="Left"
                            SelectedValuePath="Tag"
                            SelectedValue="{Binding DefaultSatelliteOrientation, Mode=TwoWay}"
                            AutomationProperties.Name="Default satellite orientation"
                            ToolTip="Set the default for new or empty layouts and apply it to the current layout when its windows can fit.">
                            <ComboBoxItem Content="Vertical" Tag="{x:Static models:SatelliteLayoutOrientation.Vertical}" />
                            <ComboBoxItem Content="Horizontal" Tag="{x:Static models:SatelliteLayoutOrientation.Horizontal}" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource SettingsItemStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding MasterRatio, StringFormat={}{0:P0}}" />
                            <TextBlock Text="Master ratio" />
                        </DockPanel>
                        <Slider
                            Minimum="0.50"
                            Maximum="0.80"
                            TickFrequency="0.01"
                            SmallChange="0.01"
                            LargeChange="0.05"
                            Value="{Binding MasterRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Master ratio"
                            ToolTip="Set the master width from 50 to 80 percent." />
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource SettingsItemStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding MaxSatellites}" />
                            <TextBlock Text="Maximum satellite windows" />
                        </DockPanel>
                        <Slider
                            Minimum="1"
                            Maximum="9"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding MaxSatellites, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Maximum satellite windows"
                            ToolTip="Set the maximum number of satellite windows from 1 to 9." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Overflow" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,20" />

                <Border Style="{DynamicResource SettingsItemStyle}">
                    <StackPanel>
                        <TextBlock Text="Overflow policy" Margin="0,0,0,8" />
                        <ComboBox
                            Width="300"
                            HorizontalAlignment="Left"
                            SelectedValuePath="Tag"
                            SelectedValue="{Binding OverflowPolicy, Mode=TwoWay}"
                            AutomationProperties.Name="Overflow policy"
                            ToolTip="Choose what happens when the current layout is full.">
                            <ComboBoxItem Content="Float on current desktop" Tag="{x:Static models:MasterSatelliteOverflowPolicy.FloatOnCurrentDesktop}" />
                            <ComboBoxItem Content="Move to an existing desktop" Tag="{x:Static models:MasterSatelliteOverflowPolicy.MoveToExistingDesktop}" />
                            <ComboBoxItem Content="Move or create a desktop" Tag="{x:Static models:MasterSatelliteOverflowPolicy.MoveToExistingOrCreateDesktop}" />
                        </ComboBox>
                        <TextBlock
                            Padding="0,12,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                            Text="An existing destination must be empty or already use Master + Satellites with a free slot. If no safe destination is available, the window remains floating so its contents and position are preserved." />
                    </StackPanel>
                </Border>

                <Border
                    Style="{DynamicResource SettingsItemStyle}"
                    IsEnabled="{Binding CanConfigureMaxAutoCreatedDesktops}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding MaxAutoCreatedDesktops}" />
                            <TextBlock Text="Maximum automatically created desktops" />
                        </DockPanel>
                        <Slider
                            Minimum="0"
                            Maximum="9"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding MaxAutoCreatedDesktops, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Maximum automatically created desktops"
                            ToolTip="Available only when the overflow policy can create desktops." />
                    </StackPanel>
                </Border>

                <Border
                    Style="{DynamicResource SettingsItemStyle}"
                    IsEnabled="{Binding CanFollowOverflowWindow}">
                    <DockPanel LastChildFill="True">
                        <CheckBox
                            DockPanel.Dock="Right"
                            IsChecked="{Binding FollowOverflowWindow, Mode=TwoWay}"
                            AutomationProperties.Name="Follow overflow window"
                            ToolTip="Switch to the destination only after the window transfer commits." />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" Text="Follow overflow window" />
                    </DockPanel>
                </Border>

                <Button
                    Margin="0,16,0,4"
                    HorizontalAlignment="Left"
                    Style="{DynamicResource AccentButtonStyle}"
                    Command="{Binding ApplyUwqhdPresetCommand}"
                    Content="Reset settings to UWQHD preset"
                    AutomationProperties.Name="Reset settings to UWQHD preset"
                    ToolTip="Set a 60% left master, vertical satellites, a limit of 3, existing-desktop overflow, and no automatic follow." />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                    Text="Changes are saved automatically. The preset resets the listed layout values, including Vertical orientation; it keeps the enabled state, display scope, desktop creation limit, and unrelated settings unchanged." />
            </ui:SimpleStackPanel>
        </ui:SimpleStackPanel>
    </Grid>
</UserControl>
